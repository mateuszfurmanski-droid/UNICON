#!/usr/bin/env python3
import time, threading, math, traceback

import cv2
from flask import Flask, Response, jsonify

# Optional deps
try:
    import serial
except Exception:
    serial = None

try:
    import smbus
except Exception:
    smbus = None


# ======================
# CONFIG
# ======================
VIDEO_DEV   = "/dev/video0"

LIDAR_PORT  = "/dev/serial0"   # TF-Luna on UART
LIDAR_BAUD  = 115200

IMU_ENABLED = True             # ICM20948 @ 0x68 on I2C-1
IMU_ADDR    = 0x68
REG_BANK_SEL= 0x7F
PWR_MGMT_1  = 0x06
PWR_MGMT_2  = 0x07
ACCEL_XOUT_H= 0x2D

PORT        = 8090


app = Flask(__name__)

latest = {
    "ts": None,
    "dist_cm": None,
    "strength": None,
    "temp_c": None,
    "roll": None,
    "pitch": None,
    "fps": None,
}

status = {
    "video_ok": False,
    "lidar_ok": False,
    "imu_ok": False,
    "errors": [],
    "boot_ts": time.time(),
}


# ======================
# HELPERS
# ======================
def set_error(tag, e):
    msg = f"{tag}: {repr(e)}"
    status["errors"] = (status["errors"] + [msg])[-10:]  # keep last 10
    # print for logs
    print(msg)
    traceback.print_exc()

def i16(h, l):
    v = (h << 8) | l
    return v - 65536 if (v & 0x8000) else v

def read_exact(ser, n):
    buf = bytearray()
    while len(buf) < n:
        b = ser.read(n - len(buf))
        if not b:
            return None
        buf.extend(b)
    return bytes(buf)


# ======================
# LiDAR LOOP (TF-Luna)
# ======================
def lidar_loop():
    if serial is None:
        status["lidar_ok"] = False
        set_error("lidar", Exception("python3-serial not installed / import failed"))
        return

    try:
        ser = serial.Serial(LIDAR_PORT, LIDAR_BAUD, timeout=0.2)
        status["lidar_ok"] = True
    except Exception as e:
        status["lidar_ok"] = False
        set_error("lidar_open", e)
        return

    while True:
        try:
            b1 = ser.read(1)
            if not b1 or b1[0] != 0x59:
                continue
            b2 = ser.read(1)
            if not b2 or b2[0] != 0x59:
                continue

            payload = read_exact(ser, 7)
            if not payload:
                continue

            frame = b"\x59\x59" + payload
            if (sum(frame[:8]) & 0xFF) != frame[8]:
                continue

            dist_mm  = frame[2] | (frame[3] << 8)   # TF-Luna zwykle raportuje w cm
            strength = frame[4] | (frame[5] << 8)
            temp     = (frame[6] | (frame[7] << 8)) / 8.0 - 256.0

            latest["ts"]       = time.time()
            latest["dist_cm"]  = float(dist_mm)
            latest["strength"] = int(strength)
            latest["temp_c"]   = round(temp, 1)
            status["lidar_ok"] = True

        except Exception as e:
            status["lidar_ok"] = False
            set_error("lidar_loop", e)
            time.sleep(0.25)


# ======================
# IMU LOOP (acc-only roll/pitch)
# ======================
def imu_select_bank(bus, b):
    bus.write_byte_data(IMU_ADDR, REG_BANK_SEL, (b & 3) << 4)
    time.sleep(0.002)

def imu_read6(bus, reg):
    d = bus.read_i2c_block_data(IMU_ADDR, reg, 6)
    return i16(d[0], d[1]), i16(d[2], d[3]), i16(d[4], d[5])

def imu_loop():
    if not IMU_ENABLED:
        status["imu_ok"] = False
        return

    if smbus is None:
        status["imu_ok"] = False
        set_error("imu", Exception("smbus not available (python3-smbus)"))
        return

    try:
        bus = smbus.SMBus(1)
        imu_select_bank(bus, 0)
        bus.write_byte_data(IMU_ADDR, PWR_MGMT_1, 0x01)
        time.sleep(0.05)
        bus.write_byte_data(IMU_ADDR, PWR_MGMT_2, 0x00)
        time.sleep(0.05)
        status["imu_ok"] = True
    except Exception as e:
        status["imu_ok"] = False
        set_error("imu_open", e)
        return

    while True:
        try:
            imu_select_bank(bus, 0)
            ax, ay, az = imu_read6(bus, ACCEL_XOUT_H)

            # roll around X, pitch around Y (acc-only)
            roll  = math.degrees(math.atan2(ay, az))
            pitch = math.degrees(math.atan2(-ax, math.sqrt(ay*ay + az*az)))

            latest["roll"]  = round(roll, 2)
            latest["pitch"] = round(pitch, 2)
            status["imu_ok"] = True

            time.sleep(0.05)

        except Exception as e:
            status["imu_ok"] = False
            set_error("imu_loop", e)
            time.sleep(0.25)


# ======================
# CAMERA STREAM (MJPEG)
# ======================
def mjpeg_frames():
    cap = cv2.VideoCapture(VIDEO_DEV, cv2.CAP_V4L2)

# WYMUSZ MJPG (UVC na Pi potrafi dawać zielony ekran bez tego)
    cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    cap.set(cv2.CAP_PROP_FPS, 15)
             time.sleep(0.2)


    status["video_ok"] = True

    # FPS calc
    t0 = time.time()
    frames = 0

    while True:
        ok, frame = cap.read()
        if (not ok) or frame is None or frame.size == 0:
             time.sleep(0.05)
             continue
 

        status["video_ok"] = True

        # overlay cross + simple horizon line from roll
        h, w = frame.shape[:2]
        cx, cy = w // 2, h // 2

        cv2.drawMarker(frame, (cx, cy), (0,255,0), cv2.MARKER_CROSS, 30, 2)

        if latest["roll"] is not None:
            ang = math.radians(latest["roll"])
            L = 220
            x1 = int(cx - L * math.cos(ang))
            y1 = int(cy - L * math.sin(ang))
            x2 = int(cx + L * math.cos(ang))
            y2 = int(cy + L * math.sin(ang))
            cv2.line(frame, (x1,y1), (x2,y2), (0,255,0), 2)

        # tiny text top-left
        txt = f"LiDAR {latest['dist_cm']}cm  S:{latest['strength']}  T:{latest['temp_c']}C  R:{latest['roll']} P:{latest['pitch']}"
        cv2.putText(frame, txt, (10,30), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0,255,0), 2)

        # fps
        frames += 1
        now = time.time()
        if now - t0 >= 1.0:
            latest["fps"] = round(frames / (now - t0), 1)
            t0 = now
            frames = 0

        ret, jpg = cv2.imencode(".jpg", frame, [int(cv2.IMWRITE_JPEG_QUALITY), 80])
        if not ret:
            continue

        yield b"--frame\r\nContent-Type: image/jpeg\r\n\r\n" + jpg.tobytes() + b"\r\n"


# ======================
# ROUTES
# ======================
@app.get("/health")
def health():
    return jsonify({"ok": True, "status": status, "latest": latest})

@app.get("/debug_imu")
def debug_imu():
    return jsonify({
        "roll": latest.get("roll"),
        "pitch": latest.get("pitch"),
        "note": "We will add /zero + calibration-save next (offsets)."
    })

@app.get("/cam.mjpg")
def cam():
    return Response(mjpeg_frames(), mimetype="multipart/x-mixed-replace; boundary=frame")

