cat > ~/UNICON/src/cam_lidar_server.py << 'EOF'
#!/usr/bin/env python3
import json, time, threading, subprocess
from http.server import BaseHTTPRequestHandler, HTTPServer

import serial

CAM_DEV = "/dev/video0"
LIDAR_PORT = "/dev/serial0"
LIDAR_BAUD = 115200
HTTP_PORT = 8081

latest = {"dist_cm": None, "strength": None, "temp_c": None, "ts": None}
lock = threading.Lock()

def read_luna_frame(ser):
    while True:
        b1 = ser.read(1)
        if not b1: return None
        if b1[0] != 0x59: continue
        b2 = ser.read(1)
        if not b2: return None
        if b2[0] != 0x59: continue
        payload = ser.read(7)
        if len(payload) != 7: return None
        frame = b"\x59\x59" + payload
        if (sum(frame[:8]) & 0xFF) != frame[8]:
            continue
        dist = frame[2] | (frame[3] << 8)
        strength = frame[4] | (frame[5] << 8)
        temp = (frame[6] | (frame[7] << 8)) / 8.0 - 256.0
        return dist, strength, temp

def lidar_thread():
    ser = serial.Serial(LIDAR_PORT, LIDAR_BAUD, timeout=1)
    time.sleep(0.2)
    while True:
        r = read_luna_frame(ser)
        if r:
            d,s,t = r
            with lock:
                latest["dist_cm"] = int(d)
                latest["strength"] = int(s)
                latest["temp_c"] = float(round(t,1))
                latest["ts"] = time.time()

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/" or self.path.startswith("/index.html"):
            html = f"""<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>UNICON Cam + LiDAR</title>
<style>
body {{ margin:0; background:#000; color:#0f0; font-family:monospace; }}
#wrap {{ position:relative; width:100vw; height:100vh; overflow:hidden; }}
#m {{ width:100vw; height:auto; display:block; }}
#hud {{
  position:absolute; top:10px; left:10px;
  background:rgba(0,0,0,0.6); padding:10px; border:1px solid #0f0;
}}
</style>
</head>
<body>
<div id="wrap">
  <img id="m" src="/mjpeg" />
  <div id="hud">Loading...</div>
</div>
<script>
async function tick(){{
  try {{
    const r = await fetch('/data', {{cache:'no-store'}});
    const j = await r.json();
    const age = j.ts ? (Date.now()/1000 - j.ts).toFixed(2) : 'na';
    document.getElementById('hud').innerText =
      `DIST: ${j.dist_cm ?? '--'} cm\\nSTR : ${j.strength ?? '--'}\\nTEMP: ${j.temp_c ?? '--'} C\\nAGE : ${age}s`;
  }} catch(e) {{}}
  setTimeout(tick, 200);
}}
tick();
</script>
</body>
</html>"""
            self.send_response(200)
            self.send_header("Content-Type","text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(html.encode("utf-8"))
            return

        if self.path.startswith("/data"):
            with lock:
                payload = dict(latest)
            self.send_response(200)
            self.send_header("Content-Type","application/json")
            self.send_header("Cache-Control","no-store")
            self.end_headers()
            self.wfile.write(json.dumps(payload).encode("utf-8"))
            return

        if self.path.startswith("/mjpeg"):
            # ffmpeg -> MJPEG stream
            self.send_response(200)
            self.send_header("Content-Type","multipart/x-mixed-replace; boundary=frame")
            self.send_header("Cache-Control","no-store")
            self.end_headers()

            cmd = [
                "ffmpeg","-hide_banner","-loglevel","error",
                "-f","v4l2","-i",CAM_DEV,
                "-vf","fps=10",
                "-q:v","5",
                "-f","mjpeg","pipe:1"
            ]
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE)

            try:
                while True:
                    # MJPEG is concatenated JPEGs. We wrap each as multipart frame.
                    chunk = p.stdout.read(4096)
                    if not chunk:
                        break
                    # write raw stream as frames boundary (best-effort)
                    self.wfile.write(b"--frame\r\n")
                    self.wfile.write(b"Content-Type: image/jpeg\r\n\r\n")
                    self.wfile.write(chunk)
                    self.wfile.write(b"\r\n")
            except BrokenPipeError:
                pass
            finally:
                p.kill()
            return

        self.send_response(404)
        self.end_headers()

def main():
    threading.Thread(target=lidar_thread, daemon=True).start()
    print(f"UNICON Cam+LiDAR server: http://0.0.0.0:{HTTP_PORT}/")
    HTTPServer(("0.0.0.0", HTTP_PORT), Handler).serve_forever()

if __name__ == "__main__":
    main()
EOF
chmod +x ~/UNICON/src/cam_lidar_server
