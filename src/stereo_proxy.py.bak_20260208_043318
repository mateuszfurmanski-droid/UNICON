#!/usr/bin/env python3
from flask import Flask, Response, send_file
import requests

PI_HOST = "127.0.0.1"
LEFT_URL  = f"http://{PI_HOST}:8101"
RIGHT_URL = f"http://{PI_HOST}:8102"

app = Flask(__name__)

@app.get("/")
def index():
    return send_file("/home/pi/UNICON/src/templates/stereo.html")

def _proxy(url):
    r = requests.get(url, stream=True, timeout=5)
    ct = r.headers.get("Content-Type", "multipart/x-mixed-replace")
    def gen():
        for chunk in r.iter_content(chunk_size=8192):
            if chunk:
                yield chunk
    return Response(gen(), content_type=ct)

@app.get("/mjpeg/left")
def left():
    return _proxy(LEFT_URL)

@app.get("/mjpeg/right")
def right():
    return _proxy(RIGHT_URL)

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=8095, threaded=True)
