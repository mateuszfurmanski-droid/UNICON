# --- LiDAR reader (best-effort, no hard fail) ---
last_lidar_m = None
lidar_ok = False

def tf_luna_reader():
    global last_lidar_m, lidar_ok
    try:
        import serial
        ser = serial.Serial(LUNA_PORT, LUNA_BAUD, timeout=0.2)
        buf = bytearray()
        lidar_ok = True
        while True:
            chunk = ser.read(64)
            if chunk:
                buf.extend(chunk)
            # parse frames: 0x59 0x59 Dist_L Dist_H Strength_L Strength_H Temp_L Temp_H Checksum
            i = 0
            while i + 9 <= len(buf):
                if buf[i] == 0x59 and buf[i+1] == 0x59:
                    frame = buf[i:i+9]
                    cs = sum(frame[:8]) & 0xFF
                    if cs == frame[8]:
                        dist_cm = frame[2] | (frame[3] << 8)
                        # dist 0 is invalid; keep last valid
                        if dist_cm > 0:
                            last_lidar_m = dist_cm / 100.0
                        i += 9
                        continue
                i += 1
            # trim buffer
            if len(buf) > 256:
                buf[:] = buf[-128:]
            time.sleep(0.01)
    except Exception:
        lidar_ok = False

threading.Thread(target=tf_luna_reader, daemon=True).start()

