@app.post("/api/tap")
def api_tap():
    data = request.get_json(silent=True) or {}
    # Accept either absolute pixels (x,y) or normalized (nx,ny)
    if "nx" in data and "ny" in data and "w" in data and "h" in data:
        x = float(data["nx"]) * float(data["w"])
        y = float(data["ny"]) * float(data["h"])
    else:
        x = float(data.get("x", 0.0))
        y = float(data.get("y", 0.0))
    BTN_STATE["last"] = {"x": x, "y": y}
    a = BTN_STATE.get("a")
    b = BTN_STATE.get("b")
    d = _dist_px(a, b) if (a and b) else None
    return jsonify({"ok": True, "state": BTN_STATE, "dist_px": d})

