import json
from flask import request, send_from_directory, render_template_string
import time
import math
import threading

import cv2
import serial
import smbus
from flask import Flask, Response, jsonify, request

# ======================
# CONFIG
# ======================
HOST = "0.0.0.0"
PORT = 8090
DATA_DIR = os.path.expanduser("~/UNICON/data")
LIVE_JOB_PATH = os.path.join(DATA_DIR, "live_job.json")

VIDEO_DEV = "/dev/video0"

# TF-Luna (Pi UART)
LIDAR_PORT = "/dev/serial0"
LIDAR_BAUD = 115200

# IMU I2C (ICM20948 often at 0x68)
IMU_ENABLED = True
IMU_I2C_BUS = 1
IMU_ADDR = 0x68

# Camera defaults (MJPG helps with green screen on many UVC cams)
CAM_WIDTH = 640
CAM_HEIGHT = 480
CAM_FPS = 15
FORCE_MJPG = True

OVERLAY_COLOR = (0, 255, 0)
FONT = cv2.FONT_HERSHEY_SIMPLEX

DATA_DIR = "/home/pi/UNICON/data"
JOB_FILE = os.path.join(DATA_DIR, "live_job.json")

# ======================
# STATE
# ======================
app = Flask(__name__)

state_lock = threading.Lock()
job_lock = threading.Lock()

status = {
    "boot_ts": time.time(),
    "errors": [],
    "video_ok": False,
    "imu_ok": False,
    "lidar_ok": False,
}

latest = {
    "ts": None,
    "dist_cm": None,
    "strength": None,
    "temp_c": None,
    "roll": None,
    "pitch": None,
    "fps": None,
}

job = {
    "version": 1,
    "created_ts": time.time(),
    "updated_ts": time.time(),
    "measurements": [],  # list of {id, ts, a:{x,y}, b:{x,y}, label}
    "next_id": 1
}

def set_error(tag, e):
    msg = f"{tag}: {repr(e)}"
    status["errors"].append(msg)
    status["errors"] = status["errors"][-30:]
job_lock = threading.Lock()

def ensure_live_job():
    os.makedirs(DATA_DIR, exist_ok=True)
    if not os.path.exists(LIVE_JOB_PATH):
        base = {"job_id": "live", "measures": [], "updated_ts": time.time()}
        with open(LIVE_JOB_PATH, "w") as f:
            json.dump(base, f)

def load_live_job():
    ensure_live_job()
    try:
        with open(LIVE_JOB_PATH, "r") as f:
            return json.load(f)
    except Exception:
        return {"job_id": "live", "measures": [], "updated_ts": time.time()}

def save_live_job(obj):
    ensure_live_job()
    obj["updated_ts"] = time.time()
    tmp = LIVE_JOB_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, LIVE_JOB_PATH)


# ======================
# JOB: autosave / autoload
# ======================
def job_save():
    os.makedirs(DATA_DIR, exist_ok=True)
    with job_lock:
        job["updated_ts"] = time.time()
        tmp = JOB_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(job, f, ensure_ascii=False, indent=2)
        os.replace(tmp, JOB_FILE)

def job_load():
    os.makedirs(DATA_DIR, exist_ok=True)
    if not os.path.exists(JOB_FILE):
        job_save()
        return
    try:
        with open(JOB_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        with job_lock:
            job.clear()
            job.update(data)
            # sanity:
            if "measurements" not in job: job["measurements"] = []
            if "next_id" not in job: job["next_id"] = 1
            if "version" not in job: job["version"] = 1
            if "created_ts" not in job: job["created_ts"] = time.time()
            job["updated_ts"] = time.time()
        job_save()
    except Exception as e:
        set_error("job_load", e)
        # fallback to empty
        with job_lock:
            job["measurements"] = []
            job["next_id"] = 1
            job["updated_ts"] = time.time()
        job_save()


# ======================
# LiDAR (TF-Luna) parsing
# ======================
def read_exact(ser, n):
    buf = bytearray()
    while len(buf) < n:
        b = ser.read(n - len(buf))
        if not b:
            return None
        buf.extend(b)
    return bytes(buf)

def lidar_loop():
    ser = None
    while True:
        try:
            ser = serial.Serial(LIDAR_PORT, LIDAR_BAUD, timeout=0.2)
            time.sleep(0.2)
            status["lidar_ok"] = True

            while True:
                b1 = ser.read(1)
                if not b1 or b1[0] != 0x59:
                    continue
                b2 = ser.read(1)
                if not b2 or b2[0] != 0x59:
                    continue

                payload = read_exact(ser, 7)
                if not payload:
                    continue

                frame = b"\x59\x59" + payload
                if (sum(frame[:8]) & 0xFF) != frame[8]:
                    continue

                dist = frame[2] | (frame[3] << 8)  # TF-Luna typically reports distance in cm
                strength = frame[4] | (frame[5] << 8)
                temp = (frame[6] | (frame[7] << 8)) / 8.0 - 256.0

                with state_lock:
                    latest["ts"] = time.time()
                    latest["dist_cm"] = float(dist)
                    latest["strength"] = int(strength)
                    latest["temp_c"] = round(temp, 1)
                    status["lidar_ok"] = True

        except Exception as e:
            status["lidar_ok"] = False
            set_error("lidar_loop", e)
            try:
                if ser:
                    ser.close()
            except Exception:
                pass
            time.sleep(0.25)


# ======================
# IMU (ICM-20948 accel only -> roll/pitch)
# ======================
REG_BANK_SEL = 0x7F
PWR_MGMT_1 = 0x06
PWR_MGMT_2 = 0x07
ACCEL_XOUT_H = 0x2D

def i16(h, l):
    v = (h << 8) | l
    return v - 65536 if (v & 0x8000) else v

def imu_select_bank(bus, b):
    bus.write_byte_data(IMU_ADDR, REG_BANK_SEL, (b & 3) << 4)
    time.sleep(0.002)

def imu_read6(bus, reg):
    d = bus.read_i2c_block_data(IMU_ADDR, reg, 6)
    ax = i16(d[0], d[1])
    ay = i16(d[2], d[3])
    az = i16(d[4], d[5])
    return ax, ay, az

def imu_loop():
    if not IMU_ENABLED:
        return

    try:
        bus = smbus.SMBus(IMU_I2C_BUS)
        imu_select_bank(bus, 0)
        bus.write_byte_data(IMU_ADDR, PWR_MGMT_1, 0x01)
        time.sleep(0.05)
        bus.write_byte_data(IMU_ADDR, PWR_MGMT_2, 0x00)
        time.sleep(0.05)
        status["imu_ok"] = True
    except Exception as e:
        status["imu_ok"] = False
        set_error("imu_init", e)
        return

    while True:
        try:
            imu_select_bank(bus, 0)
            ax, ay, az = imu_read6(bus, ACCEL_XOUT_H)

            roll = math.degrees(math.atan2(ay, az))
            pitch = math.degrees(math.atan2(-ax, math.sqrt(ay * ay + az * az)))

            with state_lock:
                latest["roll"] = round(roll, 2)
                latest["pitch"] = round(pitch, 2)
                status["imu_ok"] = True

            time.sleep(0.05)

        except Exception as e:
            status["imu_ok"] = False
            set_error("imu_loop", e)
            time.sleep(0.25)


# ======================
# CAMERA STREAM (MJPEG)
# ======================
def camera_open():
    cap = cv2.VideoCapture(VIDEO_DEV, cv2.CAP_V4L2)
    if FORCE_MJPG:
        cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, CAM_WIDTH)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAM_HEIGHT)
    cap.set(cv2.CAP_PROP_FPS, CAM_FPS)
    time.sleep(0.2)
    return cap

def mjpeg_frames():
    cap = camera_open()

    t0 = time.time()
    frames = 0

    while True:
        ok, frame = cap.read()
        if not ok or frame is None:
            status["video_ok"] = False
            try:
                cap.release()
            except Exception:
                pass
            time.sleep(0.2)
            cap = camera_open()
            continue

        status["video_ok"] = True

        frames += 1
        t1 = time.time()
        if t1 - t0 >= 1.0:
            with state_lock:
                latest["fps"] = round(frames / (t1 - t0), 1)
            t0 = t1
            frames = 0

        # Light overlay: crosshair + roll line + bottom text
        h, w = frame.shape[:2]
        cx, cy = w // 2, h // 2

        cv2.drawMarker(frame, (cx, cy), OVERLAY_COLOR, cv2.MARKER_CROSS, 28, 2)

        with state_lock:
            roll = latest.get("roll")
            pitch = latest.get("pitch")
            dist = latest.get("dist_cm")
            strength = latest.get("strength")
            temp = latest.get("temp_c")
            fps = latest.get("fps")

        if roll is not None:
            ang = math.radians(roll)
            L = int(min(w, h) * 0.35)
            x1 = int(cx - L * math.cos(ang))
            y1 = int(cy - L * math.sin(ang))
            x2 = int(cx + L * math.cos(ang))
            y2 = int(cy + L * math.sin(ang))
            cv2.line(frame, (x1, y1), (x2, y2), OVERLAY_COLOR, 2)

        txt = f"LiDAR:{dist}cm S:{strength} T:{temp}C | R:{roll} P:{pitch} | FPS:{fps}"
        cv2.putText(frame, txt, (10, h - 12), FONT, 0.55, OVERLAY_COLOR, 2)

        ret, jpg = cv2.imencode(".jpg", frame)
        if not ret:
            continue
        yield b"--frame\r\nContent-Type: image/jpeg\r\n\r\n" + jpg.tobytes() + b"\r\n"


