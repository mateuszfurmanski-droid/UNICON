    <div id="hud">boot…</div>
  </div>
</div>

<script>
(() => {
  const canvas = document.getElementById('ui');
  const ctx = canvas.getContext('2d');
  const hud = document.getElementById('hud');
  const stage = document.getElementById('stage');

  let W=0,H=0;
  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
    draw();
  }
  window.addEventListener('resize', resize);
  resize();

  // zoom
  let zoom = 1.0;
  function applyZoom() { stage.style.transform = `scale(${zoom})`; }
  applyZoom();
  window.addEventListener('wheel', (e) => {
    e.preventDefault();
    const dz = (e.deltaY < 0) ? 0.08 : -0.08;
    zoom = Math.min(2.5, Math.max(0.6, zoom + dz));
    applyZoom();
  }, {passive:false});

  // job state
  let measures = [];
  let p1 = null;

  function dist2(a,b){ const dx=a.x-b.x, dy=a.y-b.y; return dx*dx+dy*dy; }

  function linePointDistance(px,py, ax,ay, bx,by) {
    const ABx = bx-ax, ABy = by-ay;
    const APx = px-ax, APy = py-ay;
    const ab2 = ABx*ABx + ABy*ABy;
    let t = 0;
    if (ab2 > 1e-6) t = (APx*ABx + APy*ABy)/ab2;
    t = Math.max(0, Math.min(1, t));
    const cx = ax + t*ABx, cy = ay + t*ABy;
    const dx = px - cx, dy = py - cy;
    return Math.sqrt(dx*dx + dy*dy);
  }

  async function apiGet(url){ const r=await fetch(url); return await r.json(); }
  async function apiPost(url, body){
    const r = await fetch(url, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body||{})});
    return await r.json();
  }

  async function refreshJob(){
    const j = await apiGet('/api/job');
    measures = j.measurements || [];
    draw();
  }

  async function addMeasure(a,b){
    const r = await apiPost('/api/job/add', {a,b});
    measures = r.measurements || measures;
    draw();
  }

  async function deleteNearest(x,y){
    if (!measures.length) return;
    let best = {id:null, d: 1e9};
    for (const m of measures){
      const d = linePointDistance(x,y, m.a.x,m.a.y, m.b.x,m.b.y);
      if (d < best.d){ best = {id:m.id, d}; }
    }
    if (best.id !== null && best.d < 18) { // threshold px
      const r = await apiPost('/api/job/delete', {id: best.id});
      measures = r.measurements || measures;
      draw();
    }
  }

  function draw(){
    ctx.clearRect(0,0,W,H);

    // style
    ctx.lineWidth = 2;
    ctx.strokeStyle = 'rgba(0,255,0,0.9)';
    ctx.fillStyle   = 'rgba(0,255,0,0.9)';
    ctx.font = '13px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';

    // crosshair center
    const cx = W/2, cy = H/2;
    ctx.beginPath();
    ctx.moveTo(cx-14, cy); ctx.lineTo(cx+14, cy);
    ctx.moveTo(cx, cy-14); ctx.lineTo(cx, cy+14);
    ctx.stroke();

    // measurements
    for (const m of measures){
      ctx.beginPath();
      ctx.moveTo(m.a.x, m.a.y);
      ctx.lineTo(m.b.x, m.b.y);
      ctx.stroke();

      // endpoints
      ctx.beginPath();
      ctx.arc(m.a.x, m.a.y, 4, 0, Math.PI*2);
      ctx.arc(m.b.x, m.b.y, 4, 0, Math.PI*2);
      ctx.fill();

      // label
      const dx = m.b.x - m.a.x, dy = m.b.y - m.a.y;
      const px = (m.a.x + m.b.x)/2, py=(m.a.y + m.b.y)/2;
      const len = Math.sqrt(dx*dx+dy*dy);
      ctx.fillText(`#${m.id} px:${len.toFixed(0)}`, px+8, py-8);
    }

    // pending first point
    if (p1){
      ctx.beginPath();
      ctx.arc(p1.x, p1.y, 6, 0, Math.PI*2);
      ctx.fill();
      ctx.fillText('P1', p1.x+8, p1.y-8);
    }
  }

  canvas.addEventListener('mousedown', async (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    if (e.altKey) {
      await deleteNearest(x,y);
      return;
    }

    if (!p1){
      p1 = {x,y};
      draw();
      return;
    }
    const a = p1;
    const b = {x,y};
    p1 = null;
    await addMeasure(a,b);
  });

  // HUD updater
  async function tick(){
    try{
      const h = await apiGet('/health');
      const L = h.latest || {};
      const S = h.status || {};
      hud.textContent =
        `LiDAR:${L.dist_cm}cm S:${L.strength} T:${L.temp_c}C | R:${L.roll} P:${L.pitch} | FPS:${L.fps} | video:${S.video_ok} imu:${S.imu_ok} lidar:${S.lidar_ok} | errors:${(S.errors||[]).length}`;
    } catch(e){
      hud.textContent = 'health: FAIL';
    }
    setTimeout(tick, 250);
  }

  refreshJob();
  tick();
})();
</script>
</body>
</html>
"""

# ======================
# ROUTES
# ======================
@app.route("/")
def index():
    return Response(INDEX_HTML, mimetype="text/html")

@app.route("/cam.mjpg")
def cam():
    return Response(mjpeg_frames(), mimetype="multipart/x-mixed-replace; boundary=frame")

@app.route("/health")
def health():
    with state_lock:
        return jsonify({"ok": True, "status": status, "latest": latest})

@app.route("/api/live_job", methods=["GET"])
def api_live_job_get():
    with job_lock:
        job = load_live_job()
    return jsonify(job)

@app.route("/api/live_job", methods=["POST"])
def api_live_job_post():
    try:
        payload = request.get_json(force=True, silent=False)
    except Exception:
        return jsonify({"ok": False, "error": "invalid json"}), 400

    if not isinstance(payload, dict):
        return jsonify({"ok": False, "error": "json must be object"}), 400

    with job_lock:
        save_live_job(payload)

    return jsonify({"ok": True})

@app.route("/api/live_job/reset", methods=["POST"])
def api_live_job_reset():
    with job_lock:
        save_live_job({"job_id": "live", "measures": [], "updated_ts": time.time()})
    return jsonify({"ok": True})


# job API
@app.route("/api/job", methods=["GET"])
def api_job_get():
    with job_lock:
        return jsonify({
            "version": job.get("version", 1),
            "created_ts": job.get("created_ts"),
            "updated_ts": job.get("updated_ts"),
            "measurements": job.get("measurements", []),
            "next_id": job.get("next_id", 1),
        })

@app.route("/api/job/add", methods=["POST"])
def api_job_add():
    data = request.get_json(force=True, silent=True) or {}
    a = data.get("a")
    b = data.get("b")
    if not a or not b:
        return jsonify({"ok": False, "err": "missing a/b"}), 400

    with job_lock:
        mid = int(job.get("next_id", 1))
        job["next_id"] = mid + 1
        m = {
            "id": mid,
            "ts": time.time(),
            "a": {"x": float(a["x"]), "y": float(a["y"])},
            "b": {"x": float(b["x"]), "y": float(b["y"])},
            "label": data.get("label") or ""
        }
        job.setdefault("measurements", []).append(m)
    job_save()
    return api_job_get()

@app.route("/api/job/delete", methods=["POST"])
def api_job_delete():
    data = request.get_json(force=True, silent=True) or {}
    mid = data.get("id")
    if mid is None:
        return jsonify({"ok": False, "err": "missing id"}), 400
    mid = int(mid)

    with job_lock:
        ms = job.get("measurements", [])
        job["measurements"] = [m for m in ms if int(m.get("id", -1)) != mid]
    job_save()
    return api_job_get()

@app.route("/api/job/clear", methods=["POST"])
def api_job_clear():
    with job_lock:
        job["measurements"] = []
        job["next_id"] = 1
    job_save()
    return api_job_get()

@app.route("/api/job/export", methods=["GET"])
def api_job_export():
    # returns JSON exactly as stored (no clicking needed; your UI can call it or you can curl it)
    with job_lock:
        return jsonify(job)

@app.route("/api/job/import", methods=["POST"])
def api_job_import():
    # body: full job json
    data = request.get_json(force=True, silent=True)
    if not isinstance(data, dict):
        return jsonify({"ok": False, "err": "body must be json object"}), 400
    with job_lock:
        job.clear()
        job.update(data)
        if "measurements" not in job: job["measurements"] = []
        if "next_id" not in job: job["next_id"] = 1
        if "version" not in job: job["version"] = 1
        if "created_ts" not in job: job["created_ts"] = time.time()
        job["updated_ts"] = time.time()
    job_save()
    return api_job_get()

# ======================
# MAIN
# ======================
def start_threads():
    threading.Thread(target=lidar_loop, daemon=True).start()
    threading.Thread(target=imu_loop, daemon=True).start()

if __name__ == "__main__":
    job_load()
    start_threads()
    app.run(host=HOST, port=PORT, threaded=True)
