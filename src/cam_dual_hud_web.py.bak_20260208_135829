#!/usr/bin/env python3
import os, time
import cv2
from flask import Flask, Response, request, jsonify

# Devices from your mapping:
# LEFT  = /dev/video0
# RIGHT = /dev/video2
LEFT_DEV  = os.environ.get("UNICON_LEFT_DEV",  "/dev/video0")
RIGHT_DEV = os.environ.get("UNICON_RIGHT_DEV", "/dev/video2")

# Default capture params
W = int(os.environ.get("UNICON_W", "640"))
H = int(os.environ.get("UNICON_H", "480"))
FPS = int(os.environ.get("UNICON_FPS", "15"))

GREEN = (0, 255, 0)

def open_cam(dev: str):
    cap = cv2.VideoCapture(dev, cv2.CAP_V4L2)
    # Prefer MJPG if available (your cameras support MJPG)
    cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  W)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, H)
    cap.set(cv2.CAP_PROP_FPS, FPS)

    # Try to improve exposure without user walking with flashlight
    # Some drivers ignore these, that's fine.
    try:
        cap.set(cv2.CAP_PROP_AUTO_EXPOSURE, 0.75)  # "auto" in many backends
    except Exception:
        pass
    return cap

capL = open_cam(LEFT_DEV)
capR = open_cam(RIGHT_DEV)

app = Flask(__name__)

def draw_hud(frame, label: str):
    h, w = frame.shape[:2]
    # simple "laser HUD" overlay (safe baseline)
    # border
    cv2.rectangle(frame, (10,10), (w-10, h-10), GREEN, 1)
    # reticle
    cx, cy = w//2, h//2
    cv2.circle(frame, (cx, cy), 6, GREEN, 1)
    cv2.line(frame, (cx-20, cy), (cx+20, cy), GREEN, 1)
    cv2.line(frame, (cx, cy-20), (cx, cy+20), GREEN, 1)
    # label
    cv2.putText(frame, label, (20, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.7, GREEN, 2, cv2.LINE_AA)
    return frame

def mjpeg_stream(which: str):
    cap = capL if which == "left" else capR
    label = f"{which.upper()} {LEFT_DEV if which=='left' else RIGHT_DEV}"

    while True:
        ok, frame = cap.read()
        if not ok or frame is None:
            # backoff and keep stream alive
            time.sleep(0.05)
            continue

        frame = draw_hud(frame, label)

        # encode clean JPEG (browser-safe)
        ok2, jpg = cv2.imencode(".jpg", frame, [int(cv2.IMWRITE_JPEG_QUALITY), 80])
        if not ok2:
            continue

        b = jpg.tobytes()
        yield (b"--frame\r\n"
               b"Content-Type: image/jpeg\r\n"
               b"Content-Length: " + str(len(b)).encode() + b"\r\n\r\n" + b + b"\r\n")

@app.get("/")
def index():
    # simple dual view page (phone-friendly)
    html = f"""<!doctype html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>UNICON Dual Cam HUD</title>
<style>
  body {{ margin:0; background:#000; color:#0f0; font-family: monospace; }}
  .row {{ display:flex; gap:8px; padding:8px; }}
  .col {{ flex:1; border:1px solid rgba(0,255,0,0.25); border-radius:12px; overflow:hidden; }}
  img {{ width:100%; height:auto; display:block; }}
  .cap {{ padding:6px 10px; font-size:14px; opacity:0.9; }}
</style>
</head>
<body>
  <div class="row">
    <div class="col">
      <div class="cap">LEFT ({LEFT_DEV})</div>
      <img src="/mjpeg/left" />
    </div>
    <div class="col">
      <div class="cap">RIGHT ({RIGHT_DEV})</div>
      <img src="/mjpeg/right" />
    </div>
  </div>
</body>
</html>"""
    return Response(html, mimetype="text/html")

@app.get("/mjpeg/<which>")
def mjpeg(which):
    if which not in ("left","right"):
        return ("bad which", 400)
    return Response(mjpeg_stream(which), mimetype="multipart/x-mixed-replace; boundary=frame")

@app.get("/health")
def health():
    return jsonify(ok=True, left=LEFT_DEV, right=RIGHT_DEV, w=W, h=H, fps=FPS)

if __name__ == "__main__":
    # bind on all interfaces for phone access
    app.run(host="0.0.0.0", port=int(os.environ.get("UNICON_PORT","8095")), threaded=True)
