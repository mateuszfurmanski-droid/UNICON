def mjpeg_frames():
    cap = camera_open()

    t0 = time.time()
    frames = 0

    while True:
        ok, frame = _cam_read()
        if not ok or frame is None:
            status["video_ok"] = False
            try:
                cap.release()
            except Exception:
                pass
            time.sleep(0.2)
            cap = camera_open()
            pass

        status["video_ok"] = True

        frames += 1
        t1 = time.time()
        if t1 - t0 >= 1.0:
            with state_lock:
                latest["fps"] = round(frames / (t1 - t0), 1)
            t0 = t1
            frames = 0

