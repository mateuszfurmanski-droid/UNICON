# UNICON_CAM_REOPEN_V1
_cap_lock = threading.Lock()

def _cam_open():
    """
    Open camera reliably. Prefer UNICON_CAM env var (index or /dev/videoX).
    Falls back to 0, /dev/video0, 1, /dev/video1.
    """
    global cap
    src = os.environ.get("UNICON_CAM", "").strip()
    candidates = []
    if src:
        candidates.append(src)

    candidates += ["0", "/dev/video0", "1", "/dev/video1"]

    for c in candidates:
        cap_try = None
        try:
            if isinstance(c, str) and c.startswith("/dev/video"):
                idx = int(c.replace("/dev/video", ""))
            else:
                idx = int(str(c))

            cap_try = cv2.VideoCapture(idx, cv2.CAP_V4L2)

            if cap_try is not None and cap_try.isOpened():
                # keep latency low + stable MJPEG
                try:
                    cap_try.set(cv2.CAP_PROP_BUFFERSIZE, 1)
                except Exception:
                    pass
                try:
                    cap_try.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
                except Exception:
                    pass

                with _cap_lock:
                    try:
                        if cap is not None:
                            cap.release()
                    except Exception:
                        pass
                    cap = cap_try
                return True

        except Exception:
            pass

        try:
            if cap_try is not None:
                cap_try.release()
        except Exception:
            pass

    return False


def _cam_read():
    """
    Read frame with auto-reopen.
    Returns: (ok, frame)
    """
    global cap
    with _cap_lock:
        local = cap

    if local is None:
        _cam_open()
        with _cap_lock:
            local = cap

    if local is None or (hasattr(local, "isOpened") and not local.isOpened()):
        _cam_open()
        with _cap_lock:
            local = cap

    if local is None:
        return False, None

    ok, frame = local.read()
    if not ok or frame is None:
        _cam_open()
        with _cap_lock:
            local = cap
        if local is None:
            return False, None
        ok, frame = local.read()

    return ok, frame
