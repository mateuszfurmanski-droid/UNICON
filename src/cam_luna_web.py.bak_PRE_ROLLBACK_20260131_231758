# UNICON_CAM_FIX_V1
def gen_frames():
    """
    Robust MJPEG generator:
    - keeps camera alive (auto-reopen)
    - prevents 'camera appears then disappears'
    - avoids hard crash on read failures
    """
    import os, time
    import cv2

    # device: env UNICON_CAM_DEV can be "0" or "/dev/video0"
    dev = os.environ.get("UNICON_CAM_DEV", "0")
    backend = getattr(cv2, "CAP_V4L2", 0)

    def open_cam():
        try:
            idx = int(dev)
            cap = cv2.VideoCapture(idx, backend)
        except Exception:
            cap = cv2.VideoCapture(dev, backend)

        # try to reduce lag / buffering
        try: cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
        except Exception: pass
        try: cap.set(cv2.CAP_PROP_FPS, 30)
        except Exception: pass
        return cap

    cap = None
    last_ok = 0.0

    while True:
        try:
            if cap is None or (hasattr(cap, "isOpened") and (not cap.isOpened())):
                if cap is not None:
                    try: cap.release()
                    except Exception: pass
                cap = open_cam()
                time.sleep(0.10)

            ok, frame = _cam_read()
            if not ok or frame is None:
                # force reopen if camera stalls
                try: cap.release()
                except Exception: pass
                cap = None
                time.sleep(0.12)
                continue

            last_ok = time.time()

            # JPEG encode
            ok2, buffer = cv2.imencode('.jpg', frame)
            if not ok2:
                time.sleep(0.02)
                continue

            jpg = buffer.tobytes()
            yield (b'--frame\r\n'
                   b'Content-Type: image/jpeg\r\n\r\n' + jpg + b'\r\n')

            # tiny sleep to avoid CPU spike
            time.sleep(0.001)

        except GeneratorExit:
            break
        except Exception:
            # never die; just reopen cam
            try:
                if cap is not None:
                    cap.release()
            except Exception:
                pass
            cap = None
            time.sleep(0.20)
            continue

