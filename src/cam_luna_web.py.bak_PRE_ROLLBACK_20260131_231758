# CAMERA2 STREAM (MJPEG)
# ======================
def camera_open2():
    cap = cv2.VideoCapture(VIDEO_DEV2, cv2.CAP_V4L2)

    # CAM2 (older UVC) -> prefer MJPG, stable for UVC on Pi
    cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, CAM_WIDTH)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAM_HEIGHT)
    cap.set(cv2.CAP_PROP_FPS, 15)

    # Try to stabilize exposure on old cams (best effort; may be ignored)
    cap.set(cv2.CAP_PROP_AUTO_EXPOSURE, 1)  # 1=manual on some backends, ignored on others
    cap.set(cv2.CAP_PROP_EXPOSURE, -6)      # typical range negative on UVC, ignored if unsupported
    cap.set(cv2.CAP_PROP_GAIN, 0)

    import time
    time.sleep(0.25)
    return cap


def mjpeg_frames2():
    cap = camera_open2()

    while True:
        ok, frame = _cam_read()
        if not ok or frame is None:
            status["video_ok"] = False
            try:
                cap.release()
            except Exception:
                pass
            time.sleep(0.2)
            cap = camera_open2()
            pass

        # na razie: bez dodatkowych overlay (czysty obraz z cam2)
        ret, jpg = cv2.imencode(".jpg", frame)
        if not ret:
            pass
        yield b"--frame\r\nContent-Type: image/jpeg\r\n\r\n" + jpg.tobytes() + b"\r\n"


