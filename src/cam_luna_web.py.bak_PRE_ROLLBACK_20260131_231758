# JOB: autosave / autoload
# ======================
def job_save():
    os.makedirs(DATA_DIR, exist_ok=True)
    with job_lock:
        job["updated_ts"] = time.time()
        tmp = JOB_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(job, f, ensure_ascii=False, indent=2)
        os.replace(tmp, JOB_FILE)

def job_load():
    os.makedirs(DATA_DIR, exist_ok=True)
    if not os.path.exists(JOB_FILE):
        job_save()
        return
    try:
        with open(JOB_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        with job_lock:
            job.clear()
            job.update(data)
            # sanity:
            if "measurements" not in job: job["measurements"] = []
            if "next_id" not in job: job["next_id"] = 1
            if "version" not in job: job["version"] = 1
            if "created_ts" not in job: job["created_ts"] = time.time()
            job["updated_ts"] = time.time()
        job_save()
    except Exception as e:
        set_error("job_load", e)
        # fallback to empty
        with job_lock:
            job["measurements"] = []
            job["next_id"] = 1
            job["updated_ts"] = time.time()
        job_save()


