from flask import Blueprint, Response

bp_3d = Blueprint("unicon_3d_v2", __name__)

@bp_3d.route("/3d")
def three():
    html = """<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>UNICON 3D</title>
<style>
body { margin:0; background:#000; overflow:hidden; }
canvas { display:block; }
#dist {
 position:fixed;
 top:20px;
 left:20px;
 color:#00ff00;
 font-family:monospace;
 font-size:20px;
}
</style>
</head>
<body>
<div id="dist">--</div>
<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<script>
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x000000);

const camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);
camera.position.z = 3;

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

const material = new THREE.LineBasicMaterial({color:0x00ff00});
let line = null;

function updateLine(a,b){
 if(line) scene.remove(line);

 const points = [];
 points.push(new THREE.Vector3(a.x*4-2, -(a.y*3-1.5), 0));
 points.push(new THREE.Vector3(b.x*4-2, -(b.y*3-1.5), 0));

 const geometry = new THREE.BufferGeometry().setFromPoints(points);
 line = new THREE.Line(geometry, material);
 scene.add(line);

 const dx=a.x-b.x;
 const dy=a.y-b.y;
 const dz=a.z-b.z;
 const dist=Math.sqrt(dx*dx+dy*dy+dz*dz);
 document.getElementById("dist").innerText=dist.toFixed(3)+" units";
}

async function poll(){
 try{
   const r = await fetch("/api/btn2/state");
   const j = await r.json();
   if(j.state && j.state.A && j.state.B){
     updateLine(j.state.A, j.state.B);
   }
 }catch(e){}
 setTimeout(poll,300);
}
poll();

function animate(){
 requestAnimationFrame(animate);
 renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', ()=>{
 camera.aspect = window.innerWidth/window.innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(window.innerWidth, window.innerHeight);
});
</script>
</body>
</html>"""
    return Response(html, mimetype="text/html")
