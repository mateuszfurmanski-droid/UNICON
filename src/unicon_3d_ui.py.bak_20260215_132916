from flask import Blueprint, Response

bp_3d = Blueprint("unicon_3d_world", __name__)

@bp_3d.route("/3d")
def three():
    html = """<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>UNICON 3D WORLD</title>
<style>
body { margin:0; background:#000; overflow:hidden; }
canvas { display:block; }
#dist {
 position:fixed;
 top:20px;
 left:20px;
 color:#00ff00;
 font-family:monospace;
 font-size:20px;
}
</style>
</head>
<body>
<div id="dist">--</div>
<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<script>

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x000000);

const camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);
camera.position.set(0,1.5,4);

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

// GRID = world reference
const grid = new THREE.GridHelper(10, 20, 0x00ff00, 0x003300);
scene.add(grid);

// axes
const axes = new THREE.AxesHelper(2);
scene.add(axes);

const material = new THREE.LineBasicMaterial({color:0x00ff00});
let line = null;

// WORLD PLANE (true 3D anchor)
const plane = new THREE.Plane(new THREE.Vector3(0,0,1), 0);
const raycaster = new THREE.Raycaster();

function normToWorld(p){
    const mouse = new THREE.Vector2(
        p.x * 2 - 1,
        -(p.y * 2 - 1)
    );

    raycaster.setFromCamera(mouse, camera);
    const pos = new THREE.Vector3();
    raycaster.ray.intersectPlane(plane, pos);
    return pos;
}

function updateLine(a,b){
 if(line) scene.remove(line);

 const p1 = normToWorld(a);
 const p2 = normToWorld(b);

 const geometry = new THREE.BufferGeometry().setFromPoints([p1,p2]);
 line = new THREE.Line(geometry, material);
 scene.add(line);

 const dist = p1.distanceTo(p2);
 document.getElementById("dist").innerText = dist.toFixed(3) + " world units";
}

async function poll(){
 try{
   const r = await fetch("/api/btn2/state");
   const j = await r.json();
   if(j.state && j.state.A && j.state.B){
     updateLine(j.state.A, j.state.B);
   }
 }catch(e){}
 setTimeout(poll,300);
}
poll();

function animate(){
 requestAnimationFrame(animate);
 renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', ()=>{
 camera.aspect = window.innerWidth/window.innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(window.innerWidth, window.innerHeight);
});

</script>
</body>
</html>"""
    return Response(html, mimetype="text/html")
