<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>UNICON Portal</title>
  <style>
    :root { color-scheme: dark; }
    body { margin:0; font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial; background:#000; color:#c7ffd1; }
    .wrap { max-width: 980px; margin: 0 auto; padding: 14px; }
    .card { border:1px solid rgba(0,255,100,.25); border-radius: 12px; padding: 12px; background: rgba(0,40,10,.22); }
    h1 { margin: 0 0 10px; font-size: 18px; font-weight: 700; letter-spacing: .3px; }
    .row { display:flex; gap:10px; flex-wrap: wrap; align-items:center; }
    button, a.btn {
      cursor:pointer; border:1px solid rgba(0,255,100,.35);
      background: rgba(0,255,100,.08); color:#c7ffd1;
      padding: 10px 12px; border-radius: 10px; text-decoration:none; font-weight: 650;
    }
    button:hover, a.btn:hover { background: rgba(0,255,100,.14); }
    .muted { opacity:.8; font-size: 12px; }
    pre {
      margin: 12px 0 0;
      padding: 12px;
      border-radius: 12px;
      border:1px solid rgba(0,255,100,.25);
      background: rgba(0,0,0,.6);
      color:#d7ffe0;
      overflow:auto;
      min-height: 160px;
      max-height: 55vh;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .line { height:1px; background: rgba(0,255,100,.15); margin: 10px 0; }
    .ok { color:#6dff95; }
    .bad { color:#ff6d6d; }
    code { background: rgba(0,255,100,.08); padding: 2px 6px; border-radius: 8px; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>UNICON Portal (V1 test)</h1>

      <div class="row">
        <button id="btnPort">TEST 8090 (listen)</button>
        <button id="btnHealth">GET /health</button>
        <button id="btnLive">GET /api/live_job</button>
        <a class="btn" href="/cam.mjpg" target="_blank">Open /cam.mjpg</a>
        <a class="btn" href="/debug_imu" target="_blank">Open /debug_imu</a>
      </div>

      <div class="line"></div>
      <div class="muted">
        Base URL: <code id="baseUrl"></code>
        &nbsp;|&nbsp; Hint: open from phone on Wi-Fi: <code>http://192.168.0.129:8090</code>
      </div>

      <pre id="out">ready.</pre>
    </div>
  </div>

<script>
(function () {
  const out = document.getElementById("out");
  const baseUrlEl = document.getElementById("baseUrl");
  const base = location.origin;
  baseUrlEl.textContent = base;

  function print(msg, cls) {
    const prefix = cls ? (cls === "ok" ? "[OK] " : "[FAIL] ") : "";
    out.textContent = prefix + msg;
    out.className = cls ? cls : "";
  }

  async function getJSON(path) {
    const url = base + path;
    print("fetch " + url + " ...");
    const r = await fetch(url, { cache: "no-store" });
    const txt = await r.text();
    if (!r.ok) throw new Error(r.status + " " + r.statusText + " :: " + txt);
    try { return JSON.parse(txt); } catch (_) { return txt; }
  }

  document.getElementById("btnHealth").onclick = async () => {
    try {
      const j = await getJSON("/health");
      print(JSON.stringify(j, null, 2), "ok");
    } catch (e) {
      print(String(e), "bad");
    }
  };

  document.getElementById("btnLive").onclick = async () => {
    try {
      const j = await getJSON("/api/live_job");
      print(JSON.stringify(j, null, 2), "ok");
    } catch (e) {
      print(String(e), "bad");
    }
  };

  // Port test: just try /health quickly and report
  document.getElementById("btnPort").onclick = async () => {
    try {
      const r = await fetch(base + "/health", { cache: "no-store" });
      if (!r.ok) throw new Error("HTTP " + r.status);
      print("8090 reachable. /health OK.", "ok");
    } catch (e) {
      print("8090 not reachable: " + String(e), "bad");
    }
  };
})();
</script>
</body>
</html>
