from flask import Blueprint, current_app, jsonify

bp = Blueprint("plugin_btn2_fix_api_v3", __name__)

def _err(msg):
    return jsonify(ok=False, error=msg), 500

@bp.get("/api/btn2fix/state")
def state():
    fn = current_app.config.get("BTN2_STATE_FN")
    if not fn:
        return _err("BTN2_STATE_FN not bound (missing btn2_contract or bind failed)")
    return fn()

@bp.route("/api/btn2fix/<name>", methods=["GET","POST"])
def set_btn(name):
    fn = current_app.config.get("BTN2_SET_FN")
    if not fn:
        return _err("BTN2_SET_FN not bound (missing btn2_contract or bind failed)")
    return fn(name)
