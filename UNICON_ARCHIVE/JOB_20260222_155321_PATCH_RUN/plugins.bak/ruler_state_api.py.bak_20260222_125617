from flask import Blueprint, current_app, jsonify

bp = Blueprint("plugin_ruler_state_api_v2", __name__)

_STATE_EP = None
_BIND_TRIED = False

def _bind_once(app):
    global _STATE_EP, _BIND_TRIED
    if _BIND_TRIED:
        return
    _BIND_TRIED = True
    try:
        for r in app.url_map.iter_rules():
            rule = (getattr(r, "rule", "") or "")
            ep = getattr(r, "endpoint", None)
            if rule == "/api/btn2fix/state" and ep:
                _STATE_EP = ep
                break
    except Exception:
        _STATE_EP = None

@bp.get("/ruler/state")
def ruler_state():
    app = current_app._get_current_object()
    if _STATE_EP is None:
        _bind_once(app)
    if _STATE_EP is None:
        return jsonify(ok=False, error="BTN2FIX_STATE_ENDPOINT_NOT_FOUND"), 500
    fn = app.view_functions.get(_STATE_EP)
    if not fn:
        return jsonify(ok=False, error="BTN2FIX_STATE_FN_NOT_FOUND", endpoint=_STATE_EP), 500
    # Directly return btn2fix's JSON response (already shaped as {"ok":true,"state":...})
    return fn()
