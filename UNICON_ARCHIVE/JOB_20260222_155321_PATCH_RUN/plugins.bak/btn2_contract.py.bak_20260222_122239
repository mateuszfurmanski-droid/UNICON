from flask import Blueprint, current_app

bp = Blueprint("plugin_btn2_contract_v2", __name__)

def _scan_and_bind(app):
    # Bind by ROUTE RULES (stable), not endpoint names (can change).
    state_ep = None
    set_ep = None

    for r in app.url_map.iter_rules():
        rule = getattr(r, "rule", "") or ""
        ep = getattr(r, "endpoint", None)

        # State: prefer internal ruler state first
        if rule == "/_i/btn2/state":
            state_ep = ep

        # Setter: internal /_i/btn2/<name>
        if rule == "/_i/btn2/<name>":
            set_ep = ep

    # Fallbacks (older layouts)
    if state_ep is None:
        for r in app.url_map.iter_rules():
            if getattr(r, "rule", "") == "/api/btn2/state":
                state_ep = r.endpoint
                break

    if set_ep is None:
        for r in app.url_map.iter_rules():
            if getattr(r, "rule", "") == "/api/btn2/<name>":
                set_ep = r.endpoint
                break

    if state_ep and state_ep in app.view_functions:
        app.config["BTN2_STATE_FN"] = app.view_functions[state_ep]
    if set_ep and set_ep in app.view_functions:
        app.config["BTN2_SET_FN"] = app.view_functions[set_ep]

    ok_state = bool(app.config.get("BTN2_STATE_FN"))
    ok_set = bool(app.config.get("BTN2_SET_FN"))
    return ok_state, ok_set

@bp.record_once
def _bind_once(state):
    app = state.app
    ok_state, ok_set = _scan_and_bind(app)
    print("BTN2_CONTRACT_BOUND_ONCE", ok_state, ok_set)

@bp.before_app_request
def _bind_lazy():
    app = current_app
    if app.config.get("BTN2_STATE_FN") and app.config.get("BTN2_SET_FN"):
        return
    ok_state, ok_set = _scan_and_bind(app)
    if ok_state or ok_set:
        print("BTN2_CONTRACT_BOUND_LAZY", ok_state, ok_set)
