from flask import Blueprint, jsonify
import threading

bp = Blueprint("plugin_ruler_state_api_v1", __name__)

# We mirror btn2_fix_api state *in-process* without any HTTP self-calls.
# This must survive refactors (so we probe for common attribute names).
def _read_btn2fix_state():
    try:
        import btn2_fix_api as b
    except Exception:
        return {"A": None, "B": None, "last": None, "reset": 0}, "import_failed"

    # Common patterns we've used: STATE dict + LOCK, or _STATE, or state()
    for state_name in ("STATE", "_STATE", "state"):
        if hasattr(b, state_name):
            obj = getattr(b, state_name)
            if callable(obj):
                try:
                    out = obj()
                    if isinstance(out, dict):
                        return out, "callable"
                except Exception:
                    pass
            if isinstance(obj, dict):
                st = obj
                lock = getattr(b, "LOCK", None) or getattr(b, "_LOCK", None) or getattr(b, "STATE_LOCK", None)
                if isinstance(lock, threading.Lock) or hasattr(lock, "__enter__"):
                    try:
                        with lock:
                            return dict(st), "dict_locked"
                    except Exception:
                        return dict(st), "dict_unlocked"
                return dict(st), "dict_unlocked"

    # Fallback: try reading known keys directly
    A = getattr(b, "A", None)
    B = getattr(b, "B", None)
    last = getattr(b, "LAST", None) or getattr(b, "last", None)
    reset = getattr(b, "RESET", None) or getattr(b, "reset", None) or 0
    return {"A": A, "B": B, "last": last, "reset": reset}, "fallback"

@bp.get("/ruler/state")
def ruler_state():
    st, mode = _read_btn2fix_state()
    # Normalize expected shape
    if "state" in st and isinstance(st["state"], dict):
        st = st["state"]
    return jsonify(ok=True, source="btn2fix", mode=mode, state=st)
