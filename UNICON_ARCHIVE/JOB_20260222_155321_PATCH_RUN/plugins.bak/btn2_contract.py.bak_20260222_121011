from flask import Blueprint

bp = Blueprint("plugin_btn2_contract_v1", __name__)

@bp.record_once
def _bind(state):
    app = state.app

    # Prefer the moved internal routes first; then fallback to older names.
    vf = app.view_functions

    state_fn = (
        vf.get("ruler_bp.btn2_state")
        or vf.get("api_btn2_state")
        or vf.get("ruler_bp.state")
        or vf.get("btn2_state")
    )

    set_fn = (
        vf.get("api_btn2")          # /_i/btn2/<name> in cam_dual_hud_web.py
        or vf.get("ruler_bp.btn2")  # fallback
        or vf.get("btn2")           # fallback
    )

    if state_fn:
        app.config["BTN2_STATE_FN"] = state_fn
    if set_fn:
        app.config["BTN2_SET_FN"] = set_fn

    print("BTN2_CONTRACT_BOUND",
          bool(app.config.get("BTN2_STATE_FN")),
          bool(app.config.get("BTN2_SET_FN")))
